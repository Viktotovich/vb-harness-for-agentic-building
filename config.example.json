{
  "_comment": "Copy to config.json (git-ignored) or run `harness init`. Every value here is a placeholder or a default.",
  "profiles": {
    "default": {
      "baseUrl": "http://127.0.0.1:8080/v1",
      "model": "auto",
      "apiKeyEnv": null,
      "contextTokens": "probe",
      "maxOutputTokens": 4000,
      "temperature": null,
      "thinking": { "control": "probe", "effort": "low", "budgetTokens": null },
      "structuredOutput": "probe",
      "toolCalls": "probe",
      "concurrency": 1,
      "timeoutSec": 900,
      "promptNotes": null,
      "swap": { "start": null, "stop": null, "readyTimeoutSec": 300 },
      "fallback": null
    }
  },
  "roles": {
    "planner": "default",
    "implementer": "default",
    "fixer": "default",
    "reviewer": "default",
    "verifier": "default",
    "summarizer": "default"
  },
  "stack": "auto",
  "stacks": {
    "astro": {
      "detect": ["astro.config.mjs", "astro.config.ts", "astro.config.js"],
      "framework": { "name": "Astro", "lockfilePackage": "astro" },
      "docs": { "local": null, "online": false, "matchVersion": true },
      "packageManager": "auto",
      "dependencyDirs": ["node_modules"],
      "gates": {
        "format": { "argv": ["npx", "--offline", "--no", "--", "prettier", "--check", "{files}"], "scope": "touched", "blocking": false, "costRank": 1 },
        "lint": { "argv": ["npx", "--offline", "--no", "--", "eslint", "{files}"], "scope": "touched", "parser": "eslint", "costRank": 2 },
        "typecheck": { "argv": ["npx", "--offline", "--no", "--", "astro", "check"], "scope": "project", "parser": "astro_check", "costRank": 3 },
        "unit": { "argv": ["npx", "--offline", "--no", "--", "vitest", "run", "{tests}"], "scope": "tests", "parser": "vitest", "costRank": 4 },
        "build": { "argv": ["npx", "--offline", "--no", "--", "astro", "build"], "scope": "project", "when": "integration", "costRank": 8 },
        "e2e": { "argv": ["npx", "--offline", "--no", "--", "playwright", "test", "{tests}"], "scope": "tests", "when": "integration", "costRank": 9 }
      },
      "alwaysGates": ["lint", "typecheck"],
      "protectedPaths": [".git/**", ".husky/**", ".env*", "**/*.lock", "package-lock.json", "pnpm-lock.yaml", ".github/**"],
      "fixHints": [
        { "match": "Cannot find name 'props'", "hint": "In an .astro file, a component's props are Astro.props, for example: const { block } = Astro.props;" },
        { "match": "Cannot find name 'params'", "hint": "In an .astro page, route parameters are Astro.params." },
        { "match": "Unterminated regular expression literal", "hint": "In .astro markup this usually means an expression { ... } or a .map(...) block is not closed: every { needs its }, every ( its )." },
        { "match": "Expected corresponding JSX closing tag", "hint": "An element opened inside an { ... } expression must also be closed inside it." }
      ],
      "reviewNotes": [
        "Astro escapes {expression} output in markup; only set:html inserts raw HTML.",
        "An .astro file's frontmatter (between the --- lines) runs on the server; browser code goes in a <script> tag.",
        "Component props are Astro.props; a bare props is an undefined name.",
        "A request body from request.json() can be any JSON value, including a number, a string or null: check it is an object before using in, Reflect.has or property access, or the route answers 500 instead of 400.",
        "A form field or editor wired to a callback (such as onChange) must call it on every change, or the edit is never saved."
      ]
    }
  },
  "gateEnvAllow": [],
  "maxFilesPerTask": 3,
  "maxFixRounds": 3,
  "maxReplanRounds": 2,
  "maxDiagnostics": 20,
  "maxLookups": 6,
  "maxReviewFixTasks": 2,
  "wholeFileRewriteMaxBytes": 4096,
  "maxGateOutputBytes": 204800,
  "maxVerifierCalls": 60,
  "maxRefutedInARow": 3,
  "review": "full",
  "requireGreenBaseline": false,
  "dryRun": false
}
