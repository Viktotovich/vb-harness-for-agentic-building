{
  "_comment": "Copy to config.json (git-ignored) or run `harness init`. Every value here is a placeholder or a default.",
  "profiles": {
    "default": {
      "baseUrl": "http://127.0.0.1:8080/v1",
      "model": "auto",
      "apiKeyEnv": null,
      "contextTokens": "probe",
      "maxOutputTokens": 4000,
      "temperature": null,
      "thinking": { "control": "probe", "effort": "low", "budgetTokens": null },
      "structuredOutput": "probe",
      "toolCalls": "probe",
      "concurrency": 1,
      "timeoutSec": 900,
      "promptNotes": null,
      "swap": { "start": null, "stop": null, "readyTimeoutSec": 300 },
      "fallback": null
    }
  },
  "roles": {
    "planner": "default",
    "implementer": "default",
    "fixer": "default",
    "reviewer": "default",
    "verifier": "default",
    "summarizer": "default"
  },
  "stack": "auto",
  "stacks": {
    "astro": {
      "detect": ["astro.config.mjs", "astro.config.ts", "astro.config.js"],
      "framework": { "name": "Astro", "lockfilePackage": "astro" },
      "docs": { "local": null, "online": false, "matchVersion": true },
      "packageManager": "auto",
      "gates": {
        "format": { "argv": ["npx", "prettier", "--check", "{files}"], "scope": "touched", "blocking": false, "costRank": 1 },
        "lint": { "argv": ["npx", "eslint", "{files}"], "scope": "touched", "parser": "eslint", "costRank": 2 },
        "typecheck": { "argv": ["npx", "astro", "check"], "scope": "project", "parser": "astro_check", "costRank": 3 },
        "unit": { "argv": ["npx", "vitest", "run", "{tests}"], "scope": "tests", "parser": "vitest", "costRank": 4 },
        "build": { "argv": ["npx", "astro", "build"], "scope": "project", "when": "integration", "costRank": 8 },
        "e2e": { "argv": ["npx", "playwright", "test", "{tests}"], "scope": "tests", "when": "integration", "costRank": 9 }
      },
      "alwaysGates": ["lint", "typecheck"],
      "protectedPaths": [".git/**", ".husky/**", ".env*", "**/*.lock", "package-lock.json", "pnpm-lock.yaml", ".github/**"]
    }
  },
  "gateEnvAllow": [],
  "maxFilesPerTask": 3,
  "maxFixRounds": 3,
  "maxReplanRounds": 2,
  "maxDiagnostics": 20,
  "maxLookups": 6,
  "maxReviewFixTasks": 2,
  "wholeFileRewriteMaxBytes": 4096,
  "maxGateOutputBytes": 204800,
  "dryRun": false
}
